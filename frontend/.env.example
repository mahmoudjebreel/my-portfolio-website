# Frontend environment (Vite). Copy to `.env.local` to override locally.
# Everything here is PUBLIC: VITE_* values are embedded in the browser bundle.
# Never put secrets, passwords or API keys in this file.

# Base URL of the Laravel public API. Same origin by default (Vite proxy in dev, one domain in production).
VITE_API_BASE_URL=/api

# Data source: "api" (default) or "mock".
# "mock" serves the clearly marked sample data from src/mocks, works in development only,
# shows a "Mock data" badge, and makes production builds fail on purpose.
VITE_DATA_SOURCE=api

# Dev server only: where /api, /sanctum and /storage are proxied (this project's `php artisan serve`).
VITE_API_PROXY_TARGET=http://127.0.0.1:8010
